# === Data files ===
# The full corpus (raw Gutenberg downloads, processed splits, augmented
# training data, probe sets) is small (~8MB) and is tracked in git — it is
# the experiment's irreplaceable asset. Only regenerable caches are ignored.

# === Model checkpoints and adapter weights ===
*.safetensors
*.bin
*.pt
*.pth
*.gguf
checkpoints/
adapter_model/
adapter_weights/

# === Training logs ===
# Weights & Biases local artifacts
wandb/
# But keep the plain JSONL log backups (small, useful for reproducibility)
!results/**/*.jsonl

# === Large result artifacts ===
results/**/*.pkl
results/**/*.parquet
# Generated labelling tool — rebuild with scripts/eval/build_think_label_tool.py
# (embeds a snapshot of whatever think blocks exist at build time)
results/analysis/label_think_stance.html
# Generated keeper-scan page — rebuild with scripts/eval/build_keeper_scan.py
# (embeds a snapshot of the judged traces; the script + writeup are the durable
# artifacts, the HTML is regenerable)
results/analysis/keeper_scan.html

